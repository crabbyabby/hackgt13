# Keep development as the default until the production adapter TODO is implemented.
LOG_LEVEL=INFO
MODEL_PROGRESS_INTERVAL_SECONDS=10
EXTRACTION_PROVIDER=development
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-6-luna
OPENAI_PDF_MODEL=gpt-6-sol
GEMINI_API_KEY=
GEMINI_PDF_MODEL=gemini-3.8-flash
XAI_API_KEY=
XAI_PDF_MODEL=grok-4.7

# Reasoning effort spent before transcription output begins. "low" measurably flattened
# matrices and column vectors into inline lists, which reports the wrong mathematics to a
# screen reader, so quality is the default. Lower it only for throwaway runs.
# One of: none, minimal, low, medium, high.
TRANSCRIPTION_EFFORT=medium

# Fallback: write a prose reading inside the structured response when the separate
# grounding pass below is disabled. The default grounding pass supersedes this.
TRANSCRIPTION_RAW_PASS=true

# Run a free-form comprehension pass before converting the result to strict JSON.
# This costs one additional model call but produces much more cohesive notes.
TRANSCRIPTION_GROUNDING_PASS=true

# Page render density. Higher preserves handwritten sub/superscripts; lower is faster.
PAGE_RENDER_DPI=300
# Maximum pages accepted per upload.
MAX_PAGES=10

# ElevenLabs reader voice and microphone transcription.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_v3
ELEVENLABS_STT_MODEL=scribe_v2
NARRATION_MODEL=gpt-6-luna

# The Realtime voice adapter will use a server-created ephemeral credential in a later milestone.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
PYTHON_BACKEND_URL=http://127.0.0.1:8000
